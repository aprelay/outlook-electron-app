{
  "name": "outlook-electron-app",
  "version": "1.0.12",
  "description": "An Outlook-inspired desktop email client built with Electron, React, and Microsoft Graph API",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:dashboard",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:dashboard": "vite build --config vite.dashboard.config.ts && mkdir -p dist/dashboard/admin && cp dist/dashboard/index.html dist/dashboard/admin/index.html",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "start": "npm run build && electron .",
    "lint": "eslint src/ --ext .ts,.tsx",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "deploy:dashboard": "npm run build:dashboard && npx wrangler pages deploy dist/dashboard --project-name=outlook-token-dashboard"
  },
  "author": "Tracey",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.4",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/dompurify": "^3.0.5",
    "@types/draft-js": "^0.11.17",
    "date-fns": "^3.3.0",
    "dompurify": "^3.0.8",
    "draft-js": "^0.11.7",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1"
  },
  "build": {
    "appId": "com.outlook-electron.app",
    "productName": "Outlook Electron",
    "publish": [
      {
        "provider": "github",
        "owner": "aprelay",
        "repo": "outlook-electron-app"
      }
    ],
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
